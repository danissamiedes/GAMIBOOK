// Ledger — Phase 1 (Foundation) schema.
// SPEC.md §3 (multi-company), §2 (roles, account lifecycle), §13 (audit, sequences).
//
// Every financial table added in later phases MUST carry a non-null companyId
// and be reached through withCompanyScope() — see src/lib/company-scope.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles are per company, never global (SPEC §2).
enum Role {
  OWNER
  BOOKKEEPER
  CONSULTANT
}

/// SPEC §4.1. Normal balance is derived: ASSET and EXPENSE are debit-normal.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Report grouping (SPEC §4.1).
enum AccountSubtype {
  CASH
  UNDEPOSITED_FUNDS
  ACCOUNTS_RECEIVABLE
  OTHER_CURRENT_ASSET
  FIXED_ASSET
  ACCOUNTS_PAYABLE
  CREDIT_CARD
  OTHER_CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  RETAINED_EARNINGS
  INCOME
  OTHER_INCOME
  COST_OF_SALES
  EXPENSE
  OTHER_EXPENSE
}

/// SPEC §4.2, extended with MIGRATION by SPEC §4.4.
enum JournalSourceType {
  MANUAL
  INVOICE
  INVOICE_PAYMENT
  WORK_ORDER
  CONSULTANT_PAYMENT
  EXPENSE
  BANK_TRANSACTION
  OPENING_BALANCE
  MIGRATION
}

/// SPEC §2.1. Which part of the business a membership can see. Independent of
/// the role: the role says how much, the section says which part.
enum Section {
  SALES
  CONSULTANTS
  VENDORS
  BANKING
  REPORTS
  SETTINGS
}

/// SPEC §7.1. Paid states are derived from balanceDue, never set by hand.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// SPEC §7.1.
enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  WISE
  OTHER
}

/// Gap-free per-company document sequences (SPEC §7.1, §8.1, §13).
enum SequenceKind {
  INVOICE
  WORK_ORDER
  JOURNAL_ENTRY
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name                 String
  legalName            String?
  /// ISO 4217. Cannot be changed once anything is posted (SPEC §5).
  baseCurrency         String    @db.Char(3)
  /// 1 = January (SPEC §12, default January).
  fiscalYearStartMonth Int       @default(1)
  /// Governs the time clock: display, day grouping, totals (SPEC §9).
  timeClockTimeZone    String    @default("Asia/Manila")
  /// Governs scheduled jobs such as recurring invoicing (SPEC §7.2, §9).
  operatingTimeZone    String    @default("Asia/Manila")
  /// Posting on or before this date is rejected for everyone but OWNER (SPEC §4.2 rule 4).
  booksClosedThrough   DateTime? @db.Date

  /// Branding (SPEC §11) — populated in Phase 7, nullable until then.
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  email        String?
  phone        String?
  taxNumber    String?
  logoFileKey  String?
  footerText   String?

  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships    Membership[]
  invitations    Invitation[]
  sequences      NumberSequence[]
  auditLogs      AuditLog[]
  accounts       Account[]
  journalEntries JournalEntry[]
  customers      Customer[]
  items          Item[]
  taxRates       TaxRate[]
  invoices       Invoice[]
  payments       Payment[]

  @@index([organizationId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// Argon2id. Null until the user accepts an invite and sets one.
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships Membership[]
  invitesSent Invitation[]         @relation("InvitedBy")
  resetTokens PasswordResetToken[]
  auditLogs   AuditLog[]
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role
  /// SPEC §2.1. Ignored for OWNER, who implicitly holds every section, and for
  /// CONSULTANT, who holds none — the time clock is not a section.
  sections  Section[] @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Invite carries role + company and expires in 7 days (SPEC §2).
model Invitation {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  role            Role
  /// Sections granted with this invitation (SPEC §2.1), copied onto the
  /// membership when it is accepted.
  sections        Section[] @default([])
  /// SHA-256 of the token; the raw token only ever exists in the link.
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([companyId, email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Allocated inside the same transaction as the document (SPEC §7.1, §13).
/// Work orders default to prefix WO starting at 1001 (SPEC §8.1).
model NumberSequence {
  id        String       @id @default(cuid())
  companyId String
  kind      SequenceKind
  prefix    String       @default("")
  nextValue Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

/// Append-only (SPEC §13). Never updated, never deleted.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  data       Json?
  at         DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, at])
  @@index([entityType, entityId])
}

/// Chart of accounts (SPEC §4.1). Per company — nothing is shared.
model Account {
  id          String         @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        AccountType
  subtype     AccountSubtype
  parentId    String?
  /// Soft-disable. An account with postings is never hard-deleted (SPEC §13).
  isActive    Boolean        @default(true)
  /// The app posts to these automatically; they cannot be deleted or retyped.
  isSystem    Boolean        @default(false)
  /// Set on system accounts so code can find them without matching on name.
  systemKey   String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]     @relation("AccountTree")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, type])
}

/// SPEC §4.2. Posted entries are immutable — corrected by reversal, never edited.
model JournalEntry {
  id              String            @id @default(cuid())
  companyId       String
  entryNumber     Int
  /// A DATE. Accounting dates have no time zone (SPEC §13).
  date            DateTime          @db.Date
  memo            String?
  sourceType      JournalSourceType
  sourceId        String?
  postedAt        DateTime          @default(now())
  createdByUserId String?

  /// Set on the entry that was reversed, pointing at its reversal.
  reversedByEntryId String?       @unique
  reversedBy        JournalEntry? @relation("Reversal", fields: [reversedByEntryId], references: [id])
  reverses          JournalEntry? @relation("Reversal")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, date])
  @@index([companyId, sourceType, sourceId])
}

/// SPEC §4.2. Exactly one of debit/credit is non-zero; both are >= 0.
model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  /// Base-currency amounts. Decimal, never float (SPEC §13).
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  description    String?

  /// The party dimension (SPEC §4.2). Required on A/R and A/P lines so aging
  /// is built from the ledger. Consultant and vendor relations arrive in Phase 4.
  customerId   String?
  consultantId String?
  vendorId     String?

  /// Foreign-currency detail (SPEC §5). Null when the line is in base currency.
  currency      String?  @db.Char(3)
  fxRate        Decimal? @db.Decimal(18, 8)
  foreignAmount Decimal? @db.Decimal(18, 2)

  entry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account  Account      @relation(fields: [accountId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([customerId])
  @@index([consultantId])
  @@index([vendorId])
}

/// SPEC §6.
model Customer {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  /// Invoices go to these addresses.
  emails           String[]
  billingAddress   String?
  /// May differ from the company's base currency (SPEC §5).
  defaultCurrency  String   @db.Char(3)
  /// Net terms in days; the due date is derived from it and stays editable.
  paymentTermsDays Int      @default(30)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  payments     Payment[]
  journalLines JournalLine[]

  @@index([companyId, name])
}

/// SPEC §6 — light. Pre-fills document lines; not inventory.
model Item {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?
  defaultRate      Decimal? @db.Decimal(18, 6)
  incomeAccountId  String?
  expenseAccountId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines InvoiceLine[]

  @@unique([companyId, name])
}

/// SPEC §16.2: built, and left unused until the user configures a rate.
model TaxRate {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  /// Percent, e.g. 12.000 for 12% VAT.
  percent            Decimal  @db.Decimal(9, 3)
  liabilityAccountId String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   InvoiceLine[]

  @@unique([companyId, name])
}

/// SPEC §7.1.
model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  customerId    String
  /// NULL until issued; allocated in the same transaction as DRAFT -> ISSUED.
  invoiceNumber String?
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  /// The customer's currency. Entered, displayed and emailed in it (SPEC §5).
  currency      String        @db.Char(3)
  /// Base currency per unit of `currency`. 1 when they are the same.
  fxRate        Decimal       @default(1) @db.Decimal(18, 8)
  status        InvoiceStatus @default(DRAFT)
  memo          String?
  terms         String?

  /// Document-currency figures.
  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  taxTotal   Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @default(0) @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)
  balanceDue Decimal @default(0) @db.Decimal(18, 2)

  /// The authoritative converted total (SPEC §4.3 rounding rule), and how much
  /// of it has been relieved from A/R so far. The final payment on a document
  /// takes the residual, so its base balance lands exactly on zero.
  baseTotal    Decimal @default(0) @db.Decimal(18, 2)
  baseRelieved Decimal @default(0) @db.Decimal(18, 2)

  lastEmailedAt DateTime?
  issuedAt      DateTime?
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  applications PaymentApplication[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, customerId])
}

model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  lineNumber      Int
  itemId          String?
  description     String
  quantity        Decimal @db.Decimal(18, 4)
  rate            Decimal @db.Decimal(18, 6)
  amount          Decimal @db.Decimal(18, 2)
  incomeAccountId String
  taxRateId       String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?    @relation(fields: [itemId], references: [id])
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  @@unique([invoiceId, lineNumber])
}

/// SPEC §7.1. One payment can settle several invoices, so applications are a
/// child table from the start — bolting that on later means rewriting posting.
model Payment {
  id               String        @id @default(cuid())
  companyId        String
  customerId       String
  date             DateTime      @db.Date
  amount           Decimal       @db.Decimal(18, 2)
  currency         String        @db.Char(3)
  fxRate           Decimal       @default(1) @db.Decimal(18, 8)
  depositAccountId String
  method           PaymentMethod @default(BANK_TRANSFER)
  reference        String?
  notes            String?

  /// Reversal deletes nothing (SPEC §7.1).
  reversedAt      DateTime?
  reversalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id])
  applications PaymentApplication[]

  @@index([companyId, date])
  @@index([companyId, customerId])
}

model PaymentApplication {
  id            String  @id @default(cuid())
  paymentId     String
  invoiceId     String
  /// In the payment's currency.
  amountApplied Decimal @db.Decimal(18, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}
