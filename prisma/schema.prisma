// Ledger — Phase 1 (Foundation) schema.
// SPEC.md §3 (multi-company), §2 (roles, account lifecycle), §13 (audit, sequences).
//
// Every financial table added in later phases MUST carry a non-null companyId
// and be reached through withCompanyScope() — see src/lib/company-scope.ts.

generator client {
  provider      = "prisma-client-js"
  // Vercel's Node runtime is Amazon Linux, not the Debian this is developed on,
  // so the engine for it has to be generated at build time as well as the
  // native one. Harmless everywhere else.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Serverless multiplies instances, and each one opens its own connections, so
  // DATABASE_URL points at a pooler in that deployment. A pooler cannot run
  // migrations — the migration engine needs advisory locks and a session it
  // holds open — so migrations use this direct connection instead.
  //
  // It must always be set: Prisma treats a declared directUrl whose variable is
  // missing as a schema error, not as "fall back to url". On a VPS, where
  // DATABASE_URL is already a direct connection, set it to the same value.
  directUrl = env("DIRECT_DATABASE_URL")
}

/// Roles are per company, never global (SPEC §2).
enum Role {
  OWNER
  BOOKKEEPER
  CONSULTANT
}

/// SPEC §4.1. Normal balance is derived: ASSET and EXPENSE are debit-normal.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Report grouping (SPEC §4.1).
enum AccountSubtype {
  CASH
  UNDEPOSITED_FUNDS
  ACCOUNTS_RECEIVABLE
  OTHER_CURRENT_ASSET
  FIXED_ASSET
  ACCOUNTS_PAYABLE
  CREDIT_CARD
  OTHER_CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  RETAINED_EARNINGS
  INCOME
  OTHER_INCOME
  COST_OF_SALES
  EXPENSE
  OTHER_EXPENSE
}

/// SPEC §4.2, extended with MIGRATION by SPEC §4.4.
enum JournalSourceType {
  MANUAL
  INVOICE
  INVOICE_PAYMENT
  WORK_ORDER
  CONSULTANT_PAYMENT
  EXPENSE
  BANK_TRANSACTION
  OPENING_BALANCE
  MIGRATION
}

/// SPEC §2.1. Which part of the business a membership can see. Independent of
/// the role: the role says how much, the section says which part.
enum Section {
  SALES
  CONSULTANTS
  VENDORS
  BANKING
  REPORTS
  SETTINGS
}

/// SPEC §9. How a time entry came to exist, so an edited row can never be
/// mistaken for what the consultant actually recorded.
enum TimeEntrySource {
  SELF
  ADMIN_ENTERED
  ADMIN_EDITED
  AUTO_CLOSED
}

/// SPEC §6. Consultants and regular suppliers are one list with a
/// classification, so "is this person already set up?" has a single answer.
enum VendorKind {
  CONSULTANT
  REGULAR
}

/// SPEC §8.1/§8.2. Work orders and vendor bills share one machine; the UI
/// labels APPROVED as "Open" on a bill, which is the same state by another name.
enum PayableStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  VOID
}

/// SPEC §8.2. A DIRECT expense is paid as it is recorded; a BILL is owed.
enum ExpenseKind {
  DIRECT
  BILL
}

/// SPEC §8.3, §8.5, §4.4. What a batch of imported rows was for.
enum ImportBatchKind {
  WORK_ORDER
  BANK
  MIGRATION
}

/// SPEC §8.3. Upload never writes documents directly: rows are staged,
/// validated and reviewed, and only then committed.
enum ImportBatchStatus {
  PARSED
  COMMITTED
  DISCARDED
  ROLLED_BACK
}

/// SPEC §8.3. Errors block their own row and nothing else.
enum ImportRowStatus {
  VALID
  WARNING
  ERROR
  IMPORTED
  SKIPPED
}

/// SPEC §10. Every send attempt is logged, whatever happens to it.
enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

/// SPEC §10.1. A bulk send, and each message inside it.
enum EmailBatchStatus {
  QUEUED
  SENDING
  COMPLETED
  COMPLETED_WITH_FAILURES
}

enum EmailBatchItemStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// SPEC §10. The per-company templates.
enum EmailTemplateKind {
  INVOICE
  INVOICE_REMINDER
  WORK_ORDER
  PAYMENT_RECEIPT
}

/// SPEC §7.1a. A sales order is not an accounting record: confirming one posts
/// nothing, and revenue is recognised only when its invoice is issued.
enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
  CANCELLED
}

/// SPEC §8.4. A bank line is unmatched until it points at exactly one journal
/// entry, whether it created that entry or found one already there.
/// The accent a company's screens wear (SPEC §3). Structural greys and the
/// meaning colours — red for overdue, amber for warnings, green for money in —
/// are the same everywhere; only the accent moves.
enum CompanyTheme {
  BLUE
  GREEN
  PINK
  VIOLET
  TEAL
  AMBER
}

/// SPEC §8.4a.
enum ReconciliationStatus {
  IN_PROGRESS
  COMPLETED
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

/// SPEC §8.4. Statements come in two shapes and the mapping has to say which.
enum BankAmountLayout {
  /// One column, negative for money out.
  SIGNED
  /// Separate debit (out) and credit (in) columns.
  DEBIT_CREDIT
}

/// SPEC §7.2.
enum RecurringFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
}

/// SPEC §7.2: auto-sending an invoice nobody has read is a real risk, so the
/// default is a draft and sending is opt-in per template.
enum RecurringMode {
  CREATE_DRAFT
  AUTO_SEND
}

/// SPEC §7.1. Paid states are derived from balanceDue, never set by hand.
enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

/// SPEC §7.1.
enum PaymentMethod {
  BANK_TRANSFER
  CHECK
  CASH
  WISE
  OTHER
}

/// Gap-free per-company document sequences (SPEC §7.1, §8.1, §13).
enum SequenceKind {
  INVOICE
  WORK_ORDER
  JOURNAL_ENTRY
  SALES_ORDER
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companies Company[]
}

model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name                 String
  legalName            String?
  /// ISO 4217. Cannot be changed once anything is posted (SPEC §5).
  baseCurrency         String       @db.Char(3)
  /// 1 = January (SPEC §12, default January).
  fiscalYearStartMonth Int          @default(1)
  /// Governs the time clock: display, day grouping, totals (SPEC §9).
  timeClockTimeZone    String       @default("Asia/Manila")
  /// Governs scheduled jobs such as recurring invoicing (SPEC §7.2, §9).
  operatingTimeZone    String       @default("Asia/Manila")
  /// Posting on or before this date is rejected for everyone but OWNER (SPEC §4.2 rule 4).
  booksClosedThrough   DateTime?    @db.Date
  /// The accent colour this company's screens wear, so a glance says whose
  /// books are open when one login holds several (SPEC §3).
  theme                CompanyTheme @default(BLUE)

  /// Branding (SPEC §11) — populated in Phase 7, nullable until then.
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  email        String?
  phone        String?
  taxNumber    String?
  logoFileKey  String?
  footerText   String?

  /// An entry left open longer than this is auto-closed and flagged for
  /// review rather than running forever (SPEC §9).
  maxShiftHours Int @default(16)

  setupCompletedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships               Membership[]
  invitations               Invitation[]
  bankAccounts              BankAccount[]
  bankTransactions          BankTransaction[]
  sequences                 NumberSequence[]
  auditLogs                 AuditLog[]
  accounts                  Account[]
  journalEntries            JournalEntry[]
  customers                 Customer[]
  items                     Item[]
  taxRates                  TaxRate[]
  invoices                  Invoice[]
  salesOrders               SalesOrder[]
  payments                  Payment[]
  timeEntries               TimeEntry[]
  vendors                   Vendor[]
  emailConnection           EmailConnection?
  emailTemplates            EmailTemplate[]
  emailLogs                 EmailLog[]
  emailBatches              EmailBatch[]
  importBatches             ImportBatch[]
  workOrders                WorkOrder[]
  expenses                  Expense[]
  billPayments              BillPayment[]
  recurringInvoiceTemplates RecurringInvoiceTemplate[]
  recurringBillTemplates    RecurringBillTemplate[]
  bankReconciliations       BankReconciliation[]
  receiptUploads            ReceiptUpload[]

  @@index([organizationId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// Argon2id. Null until the user accepts an invite and sets one.
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships    Membership[]
  invitesSent    Invitation[]         @relation("InvitedBy")
  resetTokens    PasswordResetToken[]
  auditLogs      AuditLog[]
  vendors        Vendor[]
  receiptUploads ReceiptUpload[]
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  companyId String
  role      Role
  /// SPEC §2.1. Ignored for OWNER, who implicitly holds every section, and for
  /// CONSULTANT, who holds none — the time clock is not a section.
  sections  Section[] @default([])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Invite carries role + company and expires in 7 days (SPEC §2).
model Invitation {
  id              String    @id @default(cuid())
  companyId       String
  email           String
  role            Role
  /// Sections granted with this invitation (SPEC §2.1), copied onto the
  /// membership when it is accepted.
  sections        Section[] @default([])
  /// SHA-256 of the token; the raw token only ever exists in the link.
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedByUserId String
  createdAt       DateTime  @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([companyId, email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Allocated inside the same transaction as the document (SPEC §7.1, §13).
/// Work orders default to prefix WO starting at 1001 (SPEC §8.1).
model NumberSequence {
  id        String       @id @default(cuid())
  companyId String
  kind      SequenceKind
  prefix    String       @default("")
  nextValue Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

/// Append-only (SPEC §13). Never updated, never deleted.
model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  data       Json?
  at         DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, at])
  @@index([entityType, entityId])
}

/// Chart of accounts (SPEC §4.1). Per company — nothing is shared.
model Account {
  id          String         @id @default(cuid())
  companyId   String
  code        String
  name        String
  type        AccountType
  subtype     AccountSubtype
  parentId    String?
  /// Soft-disable. An account with postings is never hard-deleted (SPEC §13).
  isActive    Boolean        @default(true)
  /// The app posts to these automatically; they cannot be deleted or retyped.
  isSystem    Boolean        @default(false)
  /// Set on system accounts so code can find them without matching on name.
  systemKey   String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  lines        JournalLine[]
  bankAccounts BankAccount[]

  recurringBillExpenseFor RecurringBillTemplate[] @relation("RecurringBillExpenseAccount")
  recurringBillPaymentFor RecurringBillTemplate[] @relation("RecurringBillPaymentAccount")

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, type])
}

/// SPEC §4.2. Posted entries are immutable — corrected by reversal, never edited.
model JournalEntry {
  id              String            @id @default(cuid())
  companyId       String
  entryNumber     Int
  /// A DATE. Accounting dates have no time zone (SPEC §13).
  date            DateTime          @db.Date
  memo            String?
  sourceType      JournalSourceType
  sourceId        String?
  postedAt        DateTime          @default(now())
  createdByUserId String?

  /// Set on the entry that was reversed, pointing at its reversal.
  reversedByEntryId String?       @unique
  reversedBy        JournalEntry? @relation("Reversal", fields: [reversedByEntryId], references: [id])
  reverses          JournalEntry? @relation("Reversal")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines            JournalLine[]
  bankTransactions BankTransaction[]

  @@unique([companyId, entryNumber])
  @@index([companyId, date])
  @@index([companyId, sourceType, sourceId])
}

/// SPEC §4.2. Exactly one of debit/credit is non-zero; both are >= 0.
model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  lineNumber     Int
  accountId      String
  /// Base-currency amounts. Decimal, never float (SPEC §13).
  debit          Decimal @default(0) @db.Decimal(18, 2)
  credit         Decimal @default(0) @db.Decimal(18, 2)
  description    String?

  /// The party dimension (SPEC §4.2). Required on A/R and A/P lines so aging
  /// is built from the ledger rather than from document tables. Consultants
  /// are vendors with a kind (SPEC §6), so payables carry vendorId.
  customerId String?
  vendorId   String?

  /// Foreign-currency detail (SPEC §5). Null when the line is in base currency.
  currency      String?  @db.Char(3)
  fxRate        Decimal? @db.Decimal(18, 8)
  foreignAmount Decimal? @db.Decimal(18, 2)

  entry      JournalEntry            @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account    Account                 @relation(fields: [accountId], references: [id])
  customer   Customer?               @relation(fields: [customerId], references: [id])
  vendor     Vendor?                 @relation(fields: [vendorId], references: [id])
  /// Set once this line has been ticked on a bank statement (SPEC §8.4a).
  reconciled BankReconciliationLine?

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@index([customerId])
  @@index([vendorId])
}

/// SPEC §6.
model Customer {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  /// Invoices go to these addresses.
  emails           String[]
  billingAddress   String?
  /// May differ from the company's base currency (SPEC §5).
  defaultCurrency  String   @db.Char(3)
  /// Net terms in days; the due date is derived from it and stays editable.
  paymentTermsDays Int      @default(30)
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company      Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  salesOrders  SalesOrder[]
  payments     Payment[]
  journalLines JournalLine[]
  recurring    RecurringInvoiceTemplate[]

  @@index([companyId, name])
}

/// SPEC §6 — light. Pre-fills document lines; not inventory.
model Item {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  description      String?
  defaultRate      Decimal? @db.Decimal(18, 6)
  incomeAccountId  String?
  expenseAccountId String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceLines   InvoiceLine[]
  recurringLines RecurringInvoiceLine[]

  @@unique([companyId, name])
}

/// SPEC §16.2: built, and left unused until the user configures a rate.
model TaxRate {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  /// Percent, e.g. 12.000 for 12% VAT.
  percent            Decimal  @db.Decimal(9, 3)
  liabilityAccountId String
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  company        Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines          InvoiceLine[]
  recurringLines RecurringInvoiceLine[]

  @@unique([companyId, name])
}

/// SPEC §7.1.
model Invoice {
  id            String        @id @default(cuid())
  companyId     String
  customerId    String
  /// NULL until issued; allocated in the same transaction as DRAFT -> ISSUED.
  invoiceNumber String?
  issueDate     DateTime      @db.Date
  dueDate       DateTime      @db.Date
  /// The customer's currency. Entered, displayed and emailed in it (SPEC §5).
  currency      String        @db.Char(3)
  /// Base currency per unit of `currency`. 1 when they are the same.
  fxRate        Decimal       @default(1) @db.Decimal(18, 8)
  status        InvoiceStatus @default(DRAFT)
  memo          String?
  terms         String?

  /// Document-currency figures.
  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  taxTotal   Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @default(0) @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)
  balanceDue Decimal @default(0) @db.Decimal(18, 2)

  /// The authoritative converted total (SPEC §4.3 rounding rule), and how much
  /// of it has been relieved from A/R so far. The final payment on a document
  /// takes the residual, so its base balance lands exactly on zero.
  baseTotal    Decimal @default(0) @db.Decimal(18, 2)
  baseRelieved Decimal @default(0) @db.Decimal(18, 2)

  lastEmailedAt DateTime?
  issuedAt      DateTime?
  voidedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company      Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Set when this invoice was created by converting a sales order (§7.1a).
  salesOrderId String? @unique

  customer     Customer             @relation(fields: [customerId], references: [id])
  salesOrder   SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  lines        InvoiceLine[]
  applications PaymentApplication[]
  /// Set when this invoice was generated from a recurring template (§7.2).
  recurringRun RecurringInvoiceRun?

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  /// The aging reports scan by issue date, not by status (SPEC §12.5).
  @@index([companyId, issueDate])
  @@index([companyId, customerId])
}

model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  lineNumber      Int
  itemId          String?
  description     String
  quantity        Decimal @db.Decimal(18, 4)
  rate            Decimal @db.Decimal(18, 6)
  amount          Decimal @db.Decimal(18, 2)
  incomeAccountId String
  taxRateId       String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?    @relation(fields: [itemId], references: [id])
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id])

  @@unique([invoiceId, lineNumber])
}

/// SPEC §7.1. One payment can settle several invoices, so applications are a
/// child table from the start — bolting that on later means rewriting posting.
model Payment {
  id               String        @id @default(cuid())
  companyId        String
  customerId       String
  date             DateTime      @db.Date
  amount           Decimal       @db.Decimal(18, 2)
  currency         String        @db.Char(3)
  fxRate           Decimal       @default(1) @db.Decimal(18, 8)
  depositAccountId String
  method           PaymentMethod @default(BANK_TRANSFER)
  reference        String?
  notes            String?

  /// Reversal deletes nothing (SPEC §7.1).
  reversedAt      DateTime?
  reversalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer             @relation(fields: [customerId], references: [id])
  applications     PaymentApplication[]
  bankTransactions BankTransaction[]

  @@index([companyId, date])
  @@index([companyId, customerId])
}

model PaymentApplication {
  id            String  @id @default(cuid())
  paymentId     String
  invoiceId     String
  /// In the payment's currency.
  amountApplied Decimal @db.Decimal(18, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

/// SPEC §6 — one list, two kinds.
model Vendor {
  id               String     @id @default(cuid())
  companyId        String
  kind             VendorKind
  name             String
  email            String?
  /// Where remittances and correspondence go.
  address          String?
  /// May differ from the company's base currency (SPEC §5).
  defaultCurrency  String     @db.Char(3)
  defaultAccountId String?
  paymentTermsDays Int        @default(30)
  notes            String?
  isActive         Boolean    @default(true)

  /// kind = CONSULTANT only, from here down.
  /// Pre-fills work order lines.
  defaultRate   Decimal? @db.Decimal(18, 6)
  /// Lets them log in to the time clock. No user means no clock-in, which is fine.
  userId        String?
  /// Email recipient setup used by the bulk send (SPEC §10.1).
  ccEmails      String[]
  sendEmails    Boolean  @default(true)
  /// How a spreadsheet naming people by name alone is matched (SPEC §8.3).
  externalRef   String?
  importAliases String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User?                   @relation(fields: [userId], references: [id])
  workOrders   WorkOrder[]
  expenses     Expense[]
  billPayments BillPayment[]
  recurring    RecurringBillTemplate[]
  journalLines JournalLine[]
  timeEntries  TimeEntry[]

  @@unique([companyId, externalRef])
  @@index([companyId, kind, name])
}

/// SPEC §8.1. A payable to a consultant. APPROVED is what posts, dated
/// approvedAt, which defaults to the document's own issueDate.
model WorkOrder {
  id              String        @id @default(cuid())
  companyId       String
  vendorId        String
  workOrderNumber String?
  issueDate       DateTime      @db.Date
  /// The date the A/P entry posts (SPEC §8.1).
  approvedAt      DateTime?     @db.Date
  dueDate         DateTime      @db.Date
  currency        String        @db.Char(3)
  fxRate          Decimal       @default(1) @db.Decimal(18, 8)
  status          PayableStatus @default(DRAFT)
  memo            String?

  total        Decimal @default(0) @db.Decimal(18, 2)
  amountPaid   Decimal @default(0) @db.Decimal(18, 2)
  balanceDue   Decimal @default(0) @db.Decimal(18, 2)
  /// The authoritative converted total and how much of it A/P has given back,
  /// so a partial payment relieves pro rata at this document's rate (SPEC §4.3).
  baseTotal    Decimal @default(0) @db.Decimal(18, 2)
  baseRelieved Decimal @default(0) @db.Decimal(18, 2)

  lastEmailedAt    DateTime?
  approvedByUserId String?
  voidedAt         DateTime?
  /// Set when the document came from a spreadsheet import (SPEC §8.3).
  importBatchId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor           Vendor                   @relation(fields: [vendorId], references: [id])
  lines            WorkOrderLine[]
  applications     BillPaymentApplication[]
  bankTransactions BankTransaction[]

  @@unique([companyId, workOrderNumber])
  @@index([companyId, status])
  /// Approval is what makes it a payable, so that is what aging filters on.
  @@index([companyId, approvedAt])
  @@index([companyId, vendorId])
}

/// Description, quantity and rate are the three fields that matter (SPEC §8.1),
/// plus the account each line posts to (SPEC §8.3, the user's real sheet).
model WorkOrderLine {
  id          String  @id @default(cuid())
  workOrderId String
  lineNumber  Int
  description String
  quantity    Decimal @db.Decimal(18, 4)
  rate        Decimal @db.Decimal(18, 6)
  /// May be negative: a cash advance being recovered is a deduction (SPEC §8.3).
  amount      Decimal @db.Decimal(18, 2)
  accountId   String

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, lineNumber])
}

/// SPEC §8.2.
model Expense {
  id               String      @id @default(cuid())
  companyId        String
  vendorId         String?
  date             DateTime    @db.Date
  kind             ExpenseKind
  currency         String      @db.Char(3)
  fxRate           Decimal     @default(1) @db.Decimal(18, 8)
  /// Required when kind = DIRECT, null when BILL.
  paymentAccountId String?
  expenseAccountId String
  amount           Decimal     @db.Decimal(18, 2)
  description      String
  reference        String?
  receiptFileKey   String?
  /// A link to the file wherever it actually lives — a Google Drive link,
  /// typed in by hand. Independent of receiptFileKey: an expense can have a
  /// stored photo, a link, both, or neither.
  receiptUrl       String?
  isBillable       Boolean     @default(false)
  customerId       String?
  dueDate          DateTime?   @db.Date

  status       PayableStatus @default(PAID)
  amountPaid   Decimal       @default(0) @db.Decimal(18, 2)
  balanceDue   Decimal       @default(0) @db.Decimal(18, 2)
  baseTotal    Decimal       @default(0) @db.Decimal(18, 2)
  baseRelieved Decimal       @default(0) @db.Decimal(18, 2)

  voidedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company      Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor       Vendor?                  @relation(fields: [vendorId], references: [id])
  applications BillPaymentApplication[]
  receipt      ReceiptUpload?
  /// Set when this expense was recorded by a recurring template (SPEC §8.2a).
  recurringRun RecurringBillRun?

  @@index([companyId, kind, status])
  @@index([companyId, kind, date])
  @@index([companyId, vendorId])
}

/// SPEC §8.1. One model for paying consultants and regular vendors alike,
/// structurally identical to the receipts side.
model BillPayment {
  id               String        @id @default(cuid())
  companyId        String
  vendorId         String
  date             DateTime      @db.Date
  amount           Decimal       @db.Decimal(18, 2)
  currency         String        @db.Char(3)
  fxRate           Decimal       @default(1) @db.Decimal(18, 8)
  paymentAccountId String
  method           PaymentMethod @default(BANK_TRANSFER)
  reference        String?
  notes            String?

  reversedAt      DateTime?
  reversalEntryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor           Vendor                   @relation(fields: [vendorId], references: [id])
  applications     BillPaymentApplication[]
  bankTransactions BankTransaction[]

  @@index([companyId, date])
  @@index([companyId, vendorId])
}

/// Points at a work order or an expense recorded as a bill — exactly one.
model BillPaymentApplication {
  id            String  @id @default(cuid())
  billPaymentId String
  workOrderId   String?
  expenseId     String?
  amountApplied Decimal @db.Decimal(18, 2)

  billPayment BillPayment @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder?  @relation(fields: [workOrderId], references: [id])
  expense     Expense?    @relation(fields: [expenseId], references: [id])

  @@index([workOrderId])
  @@index([expenseId])
}

/// SPEC §9. Attendance, not billing: time entries never feed a work order.
model TimeEntry {
  id           String @id @default(cuid())
  companyId    String
  /// A Vendor with kind = CONSULTANT (SPEC §6).
  consultantId String

  /// UTC, always. Rendered in the company's timeClockTimeZone everywhere.
  clockInAt       DateTime
  clockOutAt      DateTime?
  /// Stored on clock-out so reports do not recompute it row by row.
  durationMinutes Int?
  note            String?

  source             TimeEntrySource @default(SELF)
  editedByUserId     String?
  editReason         String?
  /// What the row said before an admin changed it.
  originalClockInAt  DateTime?
  originalClockOutAt DateTime?

  /// The consultant can flag a row; only an admin can change a recorded time.
  correctionRequest    String?
  correctionResolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  consultant Vendor  @relation(fields: [consultantId], references: [id])

  @@index([companyId, consultantId, clockInAt])
  @@index([companyId, clockOutAt])
}

/// SPEC §7.1a. What a customer has agreed to buy, before there is an invoice.
/// It posts nothing — the order stage recognises no revenue.
model SalesOrder {
  id           String           @id @default(cuid())
  companyId    String
  customerId   String
  /// Allocated on confirmation, from its own sequence.
  orderNumber  String?
  orderDate    DateTime         @db.Date
  expectedDate DateTime?        @db.Date
  currency     String           @db.Char(3)
  fxRate       Decimal          @default(1) @db.Decimal(18, 8)
  status       SalesOrderStatus @default(DRAFT)
  memo         String?
  total        Decimal          @default(0) @db.Decimal(18, 2)

  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer         @relation(fields: [customerId], references: [id])
  lines    SalesOrderLine[]
  /// The invoice this order became, if it has been converted.
  invoice  Invoice?

  @@unique([companyId, orderNumber])
  @@index([companyId, status])
}

model SalesOrderLine {
  id              String  @id @default(cuid())
  salesOrderId    String
  lineNumber      Int
  itemId          String?
  description     String
  quantity        Decimal @db.Decimal(18, 4)
  rate            Decimal @db.Decimal(18, 6)
  amount          Decimal @db.Decimal(18, 2)
  incomeAccountId String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@unique([salesOrderId, lineNumber])
}

/// SPEC §10. One connected Gmail mailbox per company. The refresh token is
/// held under envelope encryption — a data key per record, itself encrypted
/// with the key from the environment — so a database dump alone is useless.
model EmailConnection {
  id                     String    @id @default(cuid())
  companyId              String    @unique
  /// The mailbox mail is sent from, so replies come back to a human.
  emailAddress           String
  /// Base64 of the AES-GCM ciphertext, iv and tag for the refresh token.
  refreshTokenCiphertext String
  /// The data key, itself encrypted with the environment key.
  encryptedDataKey       String
  scope                  String
  /// Set when Google rejects the token, so the UI can say "reconnect" rather
  /// than failing silently on every send.
  needsReconnectAt       DateTime?
  lastError              String?
  connectedByUserId      String?
  connectedAt            DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

/// SPEC §10. Editable per company, with a live preview and a test send.
model EmailTemplate {
  id        String            @id @default(cuid())
  companyId String
  kind      EmailTemplateKind
  subject   String
  body      String
  updatedAt DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind])
}

/// SPEC §10. Every attempt, filterable by document and by batch.
model EmailLog {
  id              String      @id @default(cuid())
  companyId       String
  toAddresses     String[]
  cc              String[]
  subject         String
  bodySnapshot    String
  attachmentNames String[]
  relatedType     String?
  relatedId       String?
  /// Set for a bulk send (SPEC §10.1), so a batch can be reviewed as a whole.
  emailBatchId    String?
  status          EmailStatus @default(QUEUED)
  gmailMessageId  String?
  error           String?
  attemptCount    Int         @default(0)
  sentAt          DateTime?
  sentByUserId    String?
  createdAt       DateTime    @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([relatedType, relatedId])
  @@index([emailBatchId])
}

/// SPEC §8.3. One upload, staged for review before anything is created.
model ImportBatch {
  id        String            @id @default(cuid())
  companyId String
  kind      ImportBatchKind
  status    ImportBatchStatus @default(PARSED)
  fileName  String
  /// SHA-256 of the upload, so re-importing the same file warns loudly.
  fileHash  String
  /// The original file, kept for audit: a batch must be able to show its source.
  fileKey   String?
  sheetName String?

  rowCount     Int @default(0)
  createdCount Int @default(0)
  skippedCount Int @default(0)

  uploadedByUserId String?
  uploadedAt       DateTime  @default(now())
  committedAt      DateTime?

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rows    ImportRow[]

  @@index([companyId, kind, uploadedAt])
  @@index([companyId, fileHash])
}

model ImportRow {
  id            String          @id @default(cuid())
  importBatchId String
  rowNumber     Int
  /// Exactly what the sheet said, before any interpretation.
  rawJson       Json
  /// What it was understood to mean, after matching and parsing.
  parsedJson    Json?
  status        ImportRowStatus @default(VALID)
  /// [{ column, message, severity }]
  issues        Json?
  /// Which document this row ended up on, once committed.
  workOrderId   String?

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
}

/// SPEC §10.1. One bulk send. Progress is read from here while it runs and
/// stays as the permanent record of what went out.
model EmailBatch {
  id        String           @id @default(cuid())
  companyId String
  kind      String           @default("WORK_ORDER")
  status    EmailBatchStatus @default(QUEUED)

  totalCount   Int @default(0)
  sentCount    Int @default(0)
  failedCount  Int @default(0)
  skippedCount Int @default(0)

  /// One email per document, or one per consultant with several attached.
  groupByConsultant Boolean @default(false)

  createdByUserId String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   EmailBatchItem[]

  @@index([companyId, createdAt])
}

/// One outgoing message. Keyed by batch and item, so "retry failed only" can
/// never re-send something that already succeeded (SPEC §10.1).
model EmailBatchItem {
  id           String               @id @default(cuid())
  emailBatchId String
  vendorId     String
  /// The documents attached to this one message.
  workOrderIds String[]
  toAddresses  String[]
  ccAddresses  String[]
  status       EmailBatchItemStatus @default(QUEUED)
  /// Why it was skipped or how it failed, in words the user can act on.
  reason       String?
  emailLogId   String?
  attempts     Int                  @default(0)
  sentAt       DateTime?

  batch EmailBatch @relation(fields: [emailBatchId], references: [id], onDelete: Cascade)

  @@index([emailBatchId, status])
}

/// SPEC §7.2. A template plus a schedule; generating an invoice from it is
/// what the daily job does.
model RecurringInvoiceTemplate {
  id         String @id @default(cuid())
  companyId  String
  customerId String
  /// Names the template in lists — "Monthly retainer", not an invoice number.
  name       String

  frequency   RecurringFrequency
  /// 1-31 for MONTHLY/QUARTERLY/ANNUALLY. Clamped to the month's last day, so
  /// "the 31st" still falls on 28 February.
  dayOfMonth  Int?
  /// 1 = Monday .. 7 = Sunday, for WEEKLY/BIWEEKLY.
  dayOfWeek   Int?
  /// For ANNUALLY: which month, 1-12.
  monthOfYear Int?

  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  occurrenceLimit Int?
  /// The next date an invoice is due to be generated for. Advanced by the job.
  nextRunDate     DateTime  @db.Date
  lastRunDate     DateTime? @db.Date
  occurrenceCount Int       @default(0)

  mode     RecurringMode @default(CREATE_DRAFT)
  isPaused Boolean       @default(false)

  /// The invoice this template writes: same fields, minus dates and numbers.
  currency         String  @db.Char(3)
  fxRate           Decimal @default(1) @db.Decimal(18, 8)
  paymentTermsDays Int     @default(30)
  memo             String?
  terms            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer               @relation(fields: [customerId], references: [id])
  lines    RecurringInvoiceLine[]
  runs     RecurringInvoiceRun[]

  @@index([companyId, isPaused, nextRunDate])
}

model RecurringInvoiceLine {
  id              String  @id @default(cuid())
  templateId      String
  lineNumber      Int
  itemId          String?
  description     String
  quantity        Decimal @db.Decimal(18, 4)
  rate            Decimal @db.Decimal(18, 6)
  incomeAccountId String
  taxRateId       String?

  template RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  item     Item?                    @relation(fields: [itemId], references: [id])
  taxRate  TaxRate?                 @relation(fields: [taxRateId], references: [id])

  @@unique([templateId, lineNumber])
}

/// One row per (template, scheduled date). The unique constraint is the
/// idempotency the spec asks for by name: a second run for the same date hits
/// it and generates nothing, however many times the job fires.
model RecurringInvoiceRun {
  id            String   @id @default(cuid())
  templateId    String
  scheduledDate DateTime @db.Date
  invoiceId     String?  @unique
  /// Set when the run produced nothing, with the reason.
  skippedReason String?
  createdAt     DateTime @default(now())

  template RecurringInvoiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  invoice  Invoice?                 @relation(fields: [invoiceId], references: [id])

  @@unique([templateId, scheduledDate])
}

/// A bill or direct expense the business owes on a schedule — rent, a retainer,
/// a utility (SPEC §8.2a). The payables mirror of RecurringInvoiceTemplate, and
/// it shares that model's schedule fields exactly so the same date maths serves
/// both.
///
/// One difference, deliberate: a recurring invoice defaults to producing a
/// draft, because auto-sending a document to a customer is consequential and
/// reversible only by apology. A bill goes to nobody — it posts what is owed —
/// so it records straight away, which is what makes A/P Aging true without
/// anyone remembering to type it in.
model RecurringBillTemplate {
  id        String  @id @default(cuid())
  companyId String
  /// Null is allowed for a DIRECT expense, required for a BILL: a bill is owed
  /// to someone, and recordExpense refuses one without a vendor.
  vendorId  String?
  /// Names the template in lists — "Office rent", not a document number.
  name      String

  /// BILL credits A/P and is cleared by a bill payment; DIRECT credits the
  /// bank on the day. Fixed after creation for the same reason an expense's
  /// kind is: switching moves money between two very different accounts.
  kind ExpenseKind

  frequency   RecurringFrequency
  /// 1-31 for MONTHLY/QUARTERLY/ANNUALLY. Clamped to the month's last day, so
  /// "the 31st" still falls on 28 February.
  dayOfMonth  Int?
  /// 1 = Monday .. 7 = Sunday, for WEEKLY/BIWEEKLY.
  dayOfWeek   Int?
  /// For ANNUALLY: which month, 1-12.
  monthOfYear Int?

  startDate       DateTime  @db.Date
  endDate         DateTime? @db.Date
  occurrenceLimit Int?
  /// The next date an expense is due to be recorded for. Advanced by the job.
  nextRunDate     DateTime  @db.Date
  lastRunDate     DateTime? @db.Date
  occurrenceCount Int       @default(0)

  isPaused Boolean @default(false)

  /// The expense this template writes.
  currency         String  @db.Char(3)
  fxRate           Decimal @default(1) @db.Decimal(18, 8)
  amount           Decimal @db.Decimal(18, 2)
  expenseAccountId String
  /// Required when kind = DIRECT: which account the money leaves.
  paymentAccountId String?
  /// Days from the bill date to its due date. Ignored for DIRECT.
  paymentTermsDays Int     @default(30)
  description      String
  reference        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendor         Vendor?            @relation(fields: [vendorId], references: [id])
  expenseAccount Account            @relation("RecurringBillExpenseAccount", fields: [expenseAccountId], references: [id])
  paymentAccount Account?           @relation("RecurringBillPaymentAccount", fields: [paymentAccountId], references: [id])
  runs           RecurringBillRun[]

  @@index([companyId, nextRunDate])
}

/// One firing of a template. The (templateId, scheduledDate) unique row is the
/// guard: the generator claims it before doing anything, so two overlapping
/// schedulers cannot record the same month's rent twice.
model RecurringBillRun {
  id            String   @id @default(cuid())
  templateId    String
  scheduledDate DateTime @db.Date
  expenseId     String?  @unique
  /// Set when the run produced nothing, with the reason.
  skippedReason String?
  createdAt     DateTime @default(now())

  template RecurringBillTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  expense  Expense?              @relation(fields: [expenseId], references: [id])

  @@unique([templateId, scheduledDate])
}

/// SPEC §8.4. A real bank account, tied to the GL account its money lands in.
/// Statement-to-book sign-off for one bank account (SPEC §8.4a).
///
/// Reconciliation asks a question import and matching cannot: does what the
/// bank says agree with what the books say, and if not, exactly which entries
/// account for the gap? So it works over **journal lines against the bank's GL
/// account**, not over imported statement rows. A payment recorded in the app
/// that never reached the statement — an uncashed cheque — is invisible to a
/// statement-row view and is precisely what reconciliation exists to surface.
model BankReconciliation {
  id                     String   @id @default(cuid())
  companyId              String
  bankAccountId          String
  /// The statement's closing date. Only lines on or before it can clear.
  statementDate          DateTime @db.Date
  /// What the bank says the account held on that date.
  statementEndingBalance Decimal  @db.Decimal(18, 2)
  /// The book balance carried in from the previous completed reconciliation,
  /// stored rather than recomputed so history cannot drift under a later edit.
  openingBalance         Decimal  @default(0) @db.Decimal(18, 2)

  status      ReconciliationStatus @default(IN_PROGRESS)
  completedAt DateTime?
  /// Set when a completed reconciliation is reopened, so the trail shows it.
  reopenedAt  DateTime?

  startedByUserId   String?
  completedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount              @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  lines       BankReconciliationLine[]

  /// One in-progress reconciliation per account at a time — two people ticking
  /// different copies of the same statement is not a state worth modelling.
  @@index([companyId, bankAccountId, statementDate])
}

/// One journal line ticked as appearing on the statement.
model BankReconciliationLine {
  id               String @id @default(cuid())
  reconciliationId String
  journalLineId    String

  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  journalLine    JournalLine        @relation(fields: [journalLineId], references: [id], onDelete: Cascade)

  /// A line belongs to at most one reconciliation: clearing it twice would
  /// count the same cash on two statements.
  @@unique([journalLineId])
  @@index([reconciliationId])
}

model BankAccount {
  id        String  @id @default(cuid())
  companyId String
  name      String
  /// CASH, UNDEPOSITED_FUNDS or CREDIT_CARD — where this account's cash sits.
  accountId String
  currency  String  @db.Char(3)
  isActive  Boolean @default(true)

  /// The saved column mapping (SPEC §8.4), so the second import is one click.
  /// Header names rather than indexes: banks reorder columns, and a name that
  /// no longer exists is a clear error where a shifted index is a silent one.
  dateColumn        String?
  descriptionColumn String?
  amountColumn      String?
  debitColumn       String?
  creditColumn      String?
  referenceColumn   String?
  amountLayout      BankAmountLayout @default(SIGNED)
  /// A date-fns pattern, e.g. dd/MM/yyyy. Banks disagree, and guessing is how
  /// a statement silently lands in the wrong month.
  dateFormat        String?

  reconciliations BankReconciliation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account      Account           @relation(fields: [accountId], references: [id])
  transactions BankTransaction[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
}

model BankTransaction {
  id            String   @id @default(cuid())
  companyId     String
  bankAccountId String
  date          DateTime @db.Date
  description   String
  /// Positive is money in, negative is money out, in the account's currency.
  amount        Decimal  @db.Decimal(18, 2)
  reference     String?
  importBatchId String?

  status BankTransactionStatus @default(UNMATCHED)

  /// Exactly one route is taken once matched (SPEC §8.4). The payment links
  /// exist so "link to an already-recorded payment" can post nothing and still
  /// be traceable to the entry that payment already wrote.
  matchedPaymentId      String?
  matchedBillPaymentId  String?
  /// The single journal entry this line accounts for, however it got there.
  matchedJournalEntryId String?
  matchedAt             DateTime?
  matchedByUserId       String?
  /// True when the match posted its own entry, so unmatching knows to reverse
  /// it rather than orphan it.
  createdEntry          Boolean   @default(false)

  /// (bankAccountId, date, amount, description), so a re-imported overlap is
  /// recognised rather than duplicated.
  dedupeHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount         BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedPayment      Payment?      @relation(fields: [matchedPaymentId], references: [id])
  matchedBillPayment  BillPayment?  @relation(fields: [matchedBillPaymentId], references: [id])
  matchedJournalEntry JournalEntry? @relation(fields: [matchedJournalEntryId], references: [id])
  workOrder           WorkOrder?    @relation(fields: [workOrderId], references: [id])
  workOrderId         String?

  @@unique([bankAccountId, dedupeHash])
  @@index([companyId, status])
  @@index([bankAccountId, date])
}

/// Login and password-reset throttling (SPEC §13).
///
/// This lives in the database rather than in memory because a serverless host
/// runs many short-lived instances: a per-process counter there resets whenever
/// a new one starts, which turns "10 attempts per 15 minutes" into "10 attempts
/// per instance", and an attacker gets a fresh allowance by waiting for one.
model RateLimit {
  /// Namespaced by caller, e.g. "login:someone@example.com" or "reset:1.2.3.4".
  key     String   @id
  count   Int      @default(0)
  /// When the current window ends. A row past this is treated as absent.
  resetAt DateTime

  @@index([resetAt])
}

/// A receipt photo waiting to become an expense (SPEC §8.2 extension).
///
/// Deliberately its own table rather than a draft Expense: a photo somebody
/// snapped is not an accounting record and must never appear in a report,
/// however incomplete. It becomes one only when a person approves it.
model ReceiptUpload {
  id        String @id @default(cuid())
  companyId String
  /// Where the image lives in object storage.
  fileKey   String
  filename  String
  mimeType  String
  byteSize  Int

  status ReceiptStatus @default(PENDING)

  /// What the reader made of the image. All nullable: extraction is a
  /// suggestion, and a receipt it cannot read is still a receipt.
  readDate        DateTime? @db.Date
  readAmount      Decimal?  @db.Decimal(18, 2)
  readCurrency    String?   @db.Char(3)
  readDescription String?
  readVendorName  String?
  /// 0..1, the reader's own confidence. Low values are flagged on screen.
  readConfidence  Decimal?  @db.Decimal(3, 2)
  /// Why extraction failed, when it did.
  readError       String?
  readAt          DateTime?

  /// Set once approved — the expense this became.
  expenseId       String?   @unique
  /// Set when someone decides it is not an expense at all.
  dismissedAt     DateTime?
  dismissedReason String?

  uploadedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  expense    Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@index([companyId, status, createdAt])
}

enum ReceiptStatus {
  /// Uploaded, not yet read.
  PENDING
  /// Read, waiting for someone to approve or correct it.
  READY
  /// Turned into an expense.
  APPROVED
  /// Not an expense — kept, but out of the queue.
  DISMISSED
}
