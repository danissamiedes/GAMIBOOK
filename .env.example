# ---- Database -----------------------------------------------------------
# Postgres connection string. With docker compose, the host is "db".
DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger_dev?schema=public"
# Separate database used by `npm test`. Tests truncate it between files.
TEST_DATABASE_URL="postgresql://ledger:ledger@localhost:5432/ledger_test?schema=public"

# ---- Auth (Auth.js / NextAuth) ------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app. Required in production.
AUTH_URL="http://localhost:3000"
# Optional Google sign-in for the APP LOGIN. This is not the Gmail sending
# connection (SPEC §10) — the two are separate concerns (SPEC §13).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- Deployment (docker-compose.prod.yml) -------------------------------
# The domain Caddy obtains a certificate for, and what AUTH_URL is built from.
# Point its DNS A record at the server before the stack first starts.
LEDGER_DOMAIN=""
# Postgres password for the production stack. Required — the production compose
# file refuses to start without it. openssl rand -base64 24
POSTGRES_PASSWORD=""

# ---- File storage (SPEC §13) --------------------------------------------
# "local" (default, a mounted volume) or "s3" (any S3-compatible bucket).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- Scheduler (SPEC §7.2, §9) ------------------------------------------
# In-process jobs: stale-shift auto-close now, recurring invoices in Phase 8.
# Enable on exactly ONE instance, or every job runs several times.
SCHEDULER_ENABLED="false"

# ---- Email (SPEC §10) ---------------------------------------------------
# Never send real mail from a dev machine. Phase 7 reads this.
EMAIL_DRY_RUN="true"
# Envelope-encryption key for stored Gmail refresh tokens (Phase 7).
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
